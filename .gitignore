# Python environment and package caches (setup.sh, learning/common.py)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.cache/
.runtime/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/

# Rust/maturin build output (engine_lite: `maturin develop --release`)
engine_lite/target/

# Run and test artifacts (run.sh, learning runs, remote CPU/GPU boxes)
runs/
tmp/
verification/
delivery/
.ops/
releases/
*.log

# Machine-local state, never source
# .ssh/ already self-ignores with `*`; repeated here so its plaintext
# server credentials and known_hosts stay untracked even if that file goes.
.ssh/
# Local agent-tool scheduler state and code graph index.
.pi/
.codegraph/

# Captured inputs live under data/, never in the source tree. Rule packages
# hold captured unit/terrain tables, catalogs and native captures and are
# provisioned per docs/instructions.md.
data/rules/

# Raw replay dumps pulled from the Steam install, curated 1.18.8 replays used
# for BC, and third-party source excerpts.
data/humanData/
data/humanData_curated/
data/datasets/human/*.jsonl
data/datasets/human/*.csv

# Whole-month replay archives pulled from replays.wesnoth.org, keyed by the
# archive's YYYYMM directory, and the standard-era corpus curated from them.
data/replays/
data/replays_curated/

# Third-party sources (Wesnoth-AI clone, upstream 1.18.8 excerpts).
data/references/
